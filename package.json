{
  "name": "copa-ace",
  "version": "1.1.0",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "jws": "3.2.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  },
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 8001",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "perf:audit": "node scripts/benchmark-performance.mjs",
    "perf:seed": "node scripts/seed-performance.mjs",
    "start": "next start -H 127.0.0.1 -p 8001",
    "lint": "eslint",
    "check": "npm run lint && tsc --noEmit && npm run test:security && npm run test:headers && npm run test:faceit-sync && npm run test:faceit-webhook && npm run test:tournaments",
    "test:security": "tsx scripts/check-security.ts",
    "test:headers": "node scripts/check-security-headers.mjs",
    "test:faceit-sync": "tsx scripts/check-faceit-sync.ts",
    "test:faceit-webhook": "tsx scripts/check-faceit-webhook.ts",
    "test:tournaments": "tsx scripts/check-tournament-formats.ts",
    "sync:faceit": "tsx scripts/sync-faceit-championships.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "15.5.24",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "lighthouse": "13.4.1",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
